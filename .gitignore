# Profile configuration - Current profile is set on startup
Profiles/current_profile.ini

# Dashboard window geometry - changes when moving or resizing
Dashboards/Macro Board/window settings.ini

# Notion Board - Persistent WebView2 browser/session data, never tracked
Dashboards/Notion Board/Browser Data/
Dashboards/Notion Board/window settings.ini

Lib/Test.ahk
Secrets/My Secrets.json
Secrets/Removed Secrets.json

# Runtime error log store (see Lib/Core/OnError.ahk)
Logs/

# Text Speaker - persisted last-used voice/volume/speed
Apps Standalone/Text Speaker/Text Speaker.settings.json

# Claude Code - local permissions and generated state
.claude/settings.local.json
.claude/scheduled_tasks.lock
CLAUDE.local.md
